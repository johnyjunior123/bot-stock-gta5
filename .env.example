# Copie este arquivo para .env e substitua os valores de exemplo.
# Os IDs são obtidos com o Modo Desenvolvedor do Discord (Copiar ID).

# Obrigatório: token do bot na seção Bot do Discord Developer Portal.
BOT_TOKEN=coloque_o_token_do_bot_aqui

# Obrigatório: conexão com o banco PostgreSQL.
# Fora do Docker, use localhost; dentro do docker-compose, use postgres como host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bot_stock?schema=public

# Obrigatório: ID do servidor onde os comandos do bot serão registrados.
MAIN_GUILD_ID=coloque_o_id_do_servidor_aqui

# Obrigatório: ID do cargo autorizado a usar os comandos administrativos
# e aprovar ou recusar entregas de farm (verificação em src/functions/auth.ts).
ALLOWED_ROLE_ID=coloque_o_id_do_cargo_autorizado_aqui

# Obrigatório para /criar-canal-farm: ID da categoria dos canais privados de farm.
CATEGORY_ID=coloque_o_id_da_categoria_aqui

# Obrigatório para /criar-canal-farm: cargo de gerente com acesso aos canais de farm.
GERENTE_ROLE_ID=coloque_o_id_do_cargo_gerente_aqui

# Obrigatório para /criar-canal-farm: cargo de administrador com acesso aos canais.
ADMIN_ROLE_ID=coloque_o_id_do_cargo_admin_aqui

# Opcional: URL do webhook usado pela base para enviar logs de erros.
# Deixe comentado se não for usar; uma URL vazia falha na validação.
# WEBHOOK_LOGS_URL=https://discord.com/api/webhooks/ID/TOKEN

# Opcional: servidor adicional para registrar comandos, aceito pela base @constatic.
# Para um único servidor, basta configurar MAIN_GUILD_ID acima e manter comentado.
# GUILD_ID=coloque_o_id_do_servidor_aqui

# Os IDs de canais e o cargo em constants.json também precisam ser configurados.
# Eles são configurações separadas e não são substituídos pelas variáveis acima.
